---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizePath } from '../../i18n/ui';
const base = import.meta.env.BASE_URL;
const L = (path: string) => localizePath(path, 'zh-Hans');

const previewScreenshots = [
  { file: 'dashboard.webp', w: 2400, h: 1187, title: '仪表盘' },
  { file: 'packages.webp', w: 2400, h: 1191, title: '软件包' },
  { file: 'installation.webp', w: 2400, h: 1189, title: '安装' },
  { file: 'services.webp', w: 2400, h: 1186, title: '服务' },
];
---

<BaseLayout title="Town OS——把云装进你家的储物间" lang="zh-Hans">
  <!-- First Release Banner -->
  <section class="release-banner">
    <div class="container">
      <div class="release-box">
        <span class="release-badge">首个版本</span>
        <p class="release-text">
          Town OS 目前处于首个发行版本。大多数功能都需要内置 DNS 服务器或
          Android 客户端——这类配置最好交给懂技术的朋友来完成。
        </p>
        <div class="release-actions">
          <a href="#install" class="btn banner-btn banner-btn-primary">立即试用</a>
          <a href={`${L('guide/')}#quick-start`} class="btn banner-btn banner-btn-outline">U 盘制作指南</a>
          <a href="https://gitea.com/town-os/town-os/issues" class="btn banner-btn banner-btn-outline" target="_blank" rel="noopener">提交问题</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <img src={`${base}images/banner.webp`} alt="" aria-hidden="true" width="1500" height="483" />
    </div>
    <div class="container hero-content">
      <h1>把云装进你家的储物间</h1>
      <div class="hero-text-box">
        <p class="hero-lead">
          在家里运行，完全掌控自己的数据和服务，
          简单到连父母都会用。
        </p>
        <ul class="hero-bullets">
          <li>从 U 盘启动，把本地存储全部留给你的数据。</li>
          <li>各组件的更新通过网络自动送达。</li>
          <li>几乎所有问题重启一下就能解决。</li>
          <li>升级核心系统只需换一个 U 盘。</li>
        </ul>
      </div>
      <div class="hero-actions">
        <a href="#install" class="btn btn-primary try-teal">
          立即试用
        </a>
        <a href={`${L('guide/')}#quick-start`} class="btn btn-primary">
          快速上手指南
        </a>
        <a href="https://gitea.com/town-os/town-os" class="btn btn-primary" target="_blank" rel="noopener">
          在 Gitea 上查看
        </a>
      </div>
    </div>
  </section>

  <!-- Preview Screenshots -->
  <section class="preview-section">
    <div class="container">
      <div class="preview-grid">
        {previewScreenshots.map((shot) => (
          <a href={L('screenshots/')} class="preview-item">
            <img
              src={`${base}images/screenshots/${shot.file}`}
              alt={shot.title}
              width={shot.w}
              height={shot.h}
              loading="lazy"
              decoding="async"
            />
            <span class="preview-label">{shot.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- What is Town OS -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Town OS 是什么？</h2>
      <div class="intro-grid">
        <div class="intro-text">
          <p>
            Town OS 是一个人人都能在家运行的自助式平台，主打极致的易用性和可靠性。
            它装在一个 U 盘上，完全在内存中运行，把电脑上的全部存储空间都留给
            <strong>你自己的东西</strong>。
          </p>
          <p>
            换个 U 盘就完成升级，重启一次就回到干净状态。没有繁琐的安装流程，
            不依赖第三方云服务商，也没有月费。Town OS 把控制权交还给你。
          </p>
          <p>
            在底层，Town OS 用 btrfs 子卷管理存储，用 systemd 管理的容器运行服务，
            并自动编排网络——包括 UPnP 端口转发和每个软件包各自的端口映射。
            这是一套为真实用户打造的完整家用服务器操作系统。
          </p>
        </div>
        <div class="intro-highlights">
          <div class="highlight-card">
            <h3>零安装</h3>
            <p>从 U 盘启动。Town OS 在内存中运行，你的硬盘只用来放数据，不用来装系统。</p>
          </div>
          <div class="highlight-card">
            <h3>随时恢复</h3>
            <p>操作失误了？重启即可回到已知良好的状态。升级只需换掉 U 盘。</p>
          </div>
          <div class="highlight-card">
            <h3>完整的容器平台</h3>
            <p>专为家庭和小型办公环境打造。通过简洁的界面从软件包仓库安装服务——引导式提问会逐项配置每个服务，网络和存储则自动管理。软件包不止于容器，也可以是虚拟机，或通过 Proton 运行的 Windows 应用。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Install Command -->
  <section class="install-banner" id="install">
    <div class="container">
      <div class="install-box">
        <p class="install-label">把 Town OS 写入 U 盘：</p>
        <div class="install-command" id="install-command">
          <code>curl -sSLO https://town-os.github.io/install.sh && bash install.sh</code>
          <button class="copy-btn" id="copy-btn" aria-label="复制到剪贴板">复制</button>
        </div>
        <p class="install-note">
          需要 <a href="https://podman.io/" target="_blank" rel="noopener">Podman</a>，
          并且会格式化你选定的 U 盘。这是一项进阶操作——如果你对命令行不熟悉，
          <strong>请找一位你信任的、懂技术的朋友帮你完成</strong>，
          这样大家就能在属于你们自己的 Town 上互通了。
        </p>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section features-section">
    <div class="container">
      <h2 class="section-title">为每个人而造</h2>
      <div class="features-grid">
        <div class="card feature-card">
          <h3>智能存储</h3>
          <p>一体化的可靠存储，完全不受操作系统影响。</p>
          <ul class="feature-list">
            <li>软件包与存储无缝集成——配额可按软件包分别管理</li>
            <li>可将卷归档并下载为压缩备份</li>
            <li>也可以上传归档，按自己的方式手动维护卷</li>
            <li>安装时会根据现有硬盘自动配置 RAID，并分组以获得最佳冗余</li>
            <li>你的数据井井有条，也受到保护</li>
          </ul>
        </div>
        <div class="card feature-card">
          <h3>一体化网络</h3>
          <p>用一台设备管理整个局域网。</p>
          <ul class="feature-list">
            <li>内置 DNS 由 <a href="https://gitea.com/town-os/rolodex" target="_blank" rel="noopener">rolodex</a> 提供——为你的软件包管理权威区域，并转发上游查询</li>
            <li>自动 UPnP 端口转发，便于从外部访问</li>
            <li>按软件包设置端口映射，并支持依赖间的网络互通</li>
            <li>DNSSEC、广告拦截、ACME 证书和 DHCP 即将推出</li>
          </ul>
        </div>
        <div class="card feature-card">
          <h3>软件包生态</h3>
          <p>点一下就能安装服务，通过引导式提问完成配置。除默认仓库外，你还可以<a href={L('packaging/')}>创建自己的仓库</a>。</p>
          <ul class="feature-list">
            <li>为你的社区或多点办公的企业建一个</li>
            <li>管理你名下的连锁咖啡店</li>
            <li>在自家的小型 ISP 上掌控整套技术栈</li>
            <li>用你希望他们使用的工具，让父母和孩子上网更安全</li>
            <li>为孩子和他们的朋友开一个 Mastodon 网络或 Minecraft 服务器</li>
            <li>Gitea、Jitsi、Plex、数据库、Web 服务器等等</li>
            <li>直接从界面发布静态 HTML 网站</li>
            <li>网络与存储按软件包自动管理</li>
          </ul>
        </div>
        <div class="card feature-card">
          <h3>友好的界面</h3>
          <p>人人都用得上的简洁仪表盘。</p>
          <ul class="feature-list">
            <li>管理服务、存储、用户和软件包</li>
            <li>内置审计日志，记录每一次操作</li>
            <li>集成 systemd 日志，实时查看服务日志</li>
            <li>Prometheus 与 Node Exporter，附带内置仪表盘——可选升级到 Grafana</li>
            <li>支持 21 种语言——欢迎社区参与翻译</li>
            <li>对非技术用户安全直观，对管理员又足够强大</li>
          </ul>
        </div>
        <div class="card feature-card">
          <h3>快速、灵活且安全</h3>
          <p>操作系统完全在内存中运行——硬盘只属于你的数据。</p>
          <ul class="feature-list">
            <li>U 盘上的不可变操作系统——从设计上就难以被篡改</li>
            <li>各组件支持在线更新</li>
            <li>升级顺畅——大多数问题重启即可解决</li>
            <li>审计日志与实时服务日志</li>
            <li>按卷管理配额</li>
            <li>检测软件包升级并在仪表盘上提醒</li>
            <li><strong>完整的 REST API</strong>——客户端已经存在，很快就会发布</li>
          </ul>
        </div>
        <div class="card feature-card">
          <h3>开源</h3>
          <p>采用 GNU AGPL 3.0 许可证。</p>
          <ul class="feature-list">
            <li>代码始终可供检视——安全从业者、自动化扫描器和监督者都能查看</li>
            <li>任何人若对其打包或修改，都必须公开发布</li>
            <li>没有人能在无人知晓的情况下损害用户的利益</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Default Packages -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">默认软件包仓库</h2>
      <div class="repo-highlight">
        <div class="repo-info">
          <p>
            每一套 Town OS 都自带
            <a href="https://github.com/town-os/default-packages" target="_blank" rel="noopener">default-packages</a>
            仓库，其中收录了一批精选的自托管服务：
          </p>
          <div class="tag-grid">
            <span class="tag">Gitea</span>
            <span class="tag">Jitsi Meet</span>
            <span class="tag">Mattermost</span>
            <span class="tag">Plex</span>
            <span class="tag">PostgreSQL</span>
          </div>
          <p>
            各软件包的测试程度不一——Gitea、Plex 和 PostgreSQL 目前运行良好。
            默认仓库还在不断扩充，欢迎提交 Pull Request 来新增或改进软件包。
            你也可以创建自己的私有仓库——非常适合家人、朋友或定制化部署。
          </p>
          <a href="https://github.com/town-os/default-packages" class="btn btn-primary" target="_blank" rel="noopener">
            在 GitHub 上浏览软件包
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Documentation quick links -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">文档</h2>
      <div class="docs-grid">
        <a href={L('concepts/')} class="card doc-link">
          <h3>核心概念</h3>
          <p>了解 Town OS 背后的核心思想——软件包、提问、服务、网络、存储和仓库。</p>
        </a>
        <a href={L('packaging/')} class="card doc-link">
          <h3>打包格式</h3>
          <p>了解软件包如何定义、模板系统如何工作，以及如何贡献你自己的软件包。</p>
        </a>
        <a href={L('api/')} class="card doc-link">
          <h3>API 参考</h3>
          <p>控制 Town OS 的完整 API——涵盖账户、存储、仓库、软件包、systemd、设置、审计、页面、DNS 等共 77 个端点。</p>
        </a>
        <a href={L('screenshots/')} class="card doc-link">
          <h3>界面截图</h3>
          <p>看看 Town OS 的实际运行效果——仪表盘、软件包管理、存储和服务监管。</p>
        </a>
      </div>
    </div>
  </section>

  <script>
    const btn = document.getElementById('copy-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText('curl -sSLO https://town-os.github.io/install.sh && bash install.sh').then(() => {
          btn.textContent = '已复制！';
          setTimeout(() => { btn.textContent = '复制'; }, 2000);
        });
      });
    }
  </script>
</BaseLayout>

<style>
  /* Install Banner */
  .install-banner {
    background: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 3.5rem 0;
  }

  .install-box {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }

  .install-label {
    color: var(--color-text);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .install-command {
    display: inline-flex;
    align-items: stretch;
    gap: 0;
    max-width: 100%;
    background: var(--color-code-bg);
    border: 2px solid var(--color-primary);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(91, 76, 158, 0.3);
  }

  .install-command code {
    padding: 1.1rem 1.5rem;
    color: var(--color-accent);
    font-size: 1.2rem;
    background: none;
    border-radius: 0;
    user-select: all;
    overflow-x: auto;
    white-space: nowrap;
  }

  .copy-btn {
    padding: 1.1rem 1.75rem;
    background: var(--color-primary);
    color: var(--color-text);
    border: none;
    border-left: 1px solid var(--color-border);
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .copy-btn:hover {
    background: var(--color-primary-light);
  }

  .install-note {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.7;
    margin: 1.5rem auto 0;
    max-width: 640px;
  }

  .install-note strong {
    color: var(--color-text);
  }

  .install-note a {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* First Release Banner */
  .release-banner {
    background: linear-gradient(135deg, #473c7a 0%, #2c2456 100%);
    border-bottom: 1px solid var(--color-primary-light);
    padding: 1.25rem 0;
  }

  .release-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .release-badge {
    display: inline-block;
    background: #1c1740;
    color: #a49dc4;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    padding: 0.4rem 1.1rem;
    border-radius: 6px;
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .release-text {
    color: #a49dc4;
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.5;
    max-width: 720px;
  }

  .release-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .banner-btn {
    padding: 0.6rem 1.4rem;
  }

  .hero-actions .try-teal {
    background: #5e857e;
    color: var(--color-bg);
  }

  .hero-actions .try-teal:hover {
    background: #6b948c;
    color: var(--color-bg);
  }

  .banner-btn-primary {
    background: #5e857e;
    color: var(--color-bg);
  }

  .banner-btn-primary:hover {
    background: #6b948c;
    color: var(--color-bg);
  }

  .banner-btn-outline {
    background: rgba(0, 0, 0, 0.2);
    color: #a49dc4;
    border: 2px solid rgba(255, 255, 255, 0.5);
  }

  .banner-btn-outline:hover {
    background: rgba(0, 0, 0, 0.35);
    border-color: #fff;
  }

  /* Preview Screenshots */
  .preview-section {
    background: var(--color-bg);
    padding: 2.5rem 0;
  }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .preview-item {
    display: block;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }

  .preview-item:hover {
    border-color: var(--color-primary-dim);
    transform: translateY(-2px);
  }

  .preview-item img {
    width: 100%;
    height: auto;
    display: block;
  }

  .preview-label {
    display: block;
    padding: 0.5rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-align: center;
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 0 5rem;
    text-align: center;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
  }


  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-logo {
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 4px 20px rgba(91, 76, 158, 0.4));
  }

  .hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-text-box {
    background: rgba(0, 0, 0, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 12px;
    padding: 1.75rem 2.25rem;
    max-width: 640px;
    margin: 0 auto 2rem;
  }

  .hero-lead {
    font-size: 1.25rem;
    color: #c0c0d0;
    font-weight: 700;
    margin: 0 0 1rem;
    line-height: 1.7;
  }

  .hero-bullets {
    list-style: none;
    margin: 0;
    padding-left: 1.5rem;
    text-align: left;
  }

  .hero-bullets li {
    color: #a8a8b8;
    font-size: 1.1rem;
    line-height: 1.8;
    padding-left: 1.5rem;
    position: relative;
  }

  .hero-bullets li::before {
    content: "\2022";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Intro */
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .intro-text p {
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    font-size: 1.05rem;
  }

  .intro-text strong {
    color: var(--color-text);
  }

  .intro-highlights {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .highlight-card {
    background: var(--color-bg-card);
    border-left: 3px solid var(--color-primary);
    padding: 1.25rem 1.5rem;
    border-radius: 0 8px 8px 0;
  }

  .highlight-card h3 {
    margin-bottom: 0.4rem;
    font-size: 1.1rem;
  }

  .highlight-card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  /* Features */
  .features-section {
    background: var(--color-bg-elevated);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .feature-card h3 {
    margin-bottom: 0.6rem;
    color: var(--color-accent);
  }

  .feature-card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .feature-list li {
    color: var(--color-text-muted);
