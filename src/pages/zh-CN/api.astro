      <div class="table-wrapper">
        <table>
          <thead><tr><th>方法</th><th>说明</th></tr></thead>
          <tbody>
            <tr><td><code>ping()</code></td><td>服务健康状况与各项计数摘要。</td></tr>
          </tbody>
        </table>
      </div>
    </div>
