---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizePath } from '../../i18n/ui';
const base = import.meta.env.BASE_URL;
const L = (path: string) => localizePath(path, 'es-ES');

const previewScreenshots = [
  { file: 'dashboard.webp', w: 2400, h: 1187, title: 'Panel' },
  { file: 'packages.webp', w: 2400, h: 1191, title: 'Paquetes' },
  { file: 'installation.webp', w: 2400, h: 1189, title: 'Instalación' },
  { file: 'services.webp', w: 2400, h: 1186, title: 'Servicios' },
];
---

<BaseLayout title="Town OS — Tu nube en tu armario" lang="es-ES">
  <!-- First Release Banner -->
  <section class="release-banner">
    <div class="container">
      <div class="release-box">
        <span class="release-badge">PRIMERA VERSIÓN</span>
        <p class="release-text">
          Town OS está en su primera versión. La mayoría de las funciones necesitan su
          servidor DNS integrado o el cliente de Android — una configuración que conviene
          dejar en manos de un amigo con conocimientos técnicos.
        </p>
        <div class="release-actions">
          <a href="#install" class="btn banner-btn banner-btn-primary">Pruébalo</a>
          <a href={`${L('guide/')}#quick-start`} class="btn banner-btn banner-btn-outline">Guía de la memoria USB</a>
          <a href="https://gitea.com/town-os/town-os/issues" class="btn banner-btn banner-btn-outline" target="_blank" rel="noopener">Informar de un problema</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg">
      <img src={`${base}images/banner.webp`} alt="" aria-hidden="true" width="1500" height="483" />
    </div>
    <div class="container hero-content">
      <h1>Tu nube en tu armario</h1>
      <div class="hero-text-box">
        <p class="hero-lead">
          Control total sobre tus datos y servicios, funcionando en casa,
          y lo bastante sencillo como para que lo usen tus padres.
        </p>
        <ul class="hero-bullets">
          <li>Arranca desde una memoria USB y dedica todo el almacenamiento local a tus datos.</li>
          <li>Las actualizaciones de los componentes llegan por la red.</li>
          <li>Casi todo se arregla reiniciando.</li>
          <li>Actualizar el sistema base es solo cambiar la memoria USB.</li>
        </ul>
      </div>
      <div class="hero-actions">
        <a href="#install" class="btn btn-primary try-teal">
          Pruébalo
        </a>
        <a href={`${L('guide/')}#quick-start`} class="btn btn-primary">
          Guía de inicio rápido
        </a>
        <a href="https://gitea.com/town-os/town-os" class="btn btn-primary" target="_blank" rel="noopener">
          Verlo en Gitea
        </a>
      </div>
    </div>
  </section>

  <!-- Preview Screenshots -->
  <section class="preview-section">
    <div class="container">
      <div class="preview-grid">
        {previewScreenshots.map((shot) => (
          <a href={L('screenshots/')} class="preview-item">
            <img
              src={`${base}images/screenshots/${shot.file}`}
              alt={shot.title}
              width={shot.w}
              height={shot.h}
              loading="lazy"
              decoding="async"
            />
            <span class="preview-label">{shot.title}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- What is Town OS -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">¿Qué es Town OS?</h2>
      <div class="intro-grid">
        <div class="intro-text">
          <p>
            Town OS es una plataforma autogestionada que cualquiera puede tener en casa,
            hecha para ser sencilla de usar y fiable. Vive en una memoria USB, se ejecuta
            por completo en memoria y dedica todo el almacenamiento de tu ordenador a
            <strong>tus cosas</strong>.
          </p>
          <p>
            Actualiza cambiando la memoria USB. Vuelve a un estado limpio reiniciando.
            Sin procedimientos de instalación complicados, sin depender de proveedores de
            nube externos y sin cuotas mensuales. Town OS te devuelve el control.
          </p>
          <p>
            Por dentro, Town OS gestiona el almacenamiento con subvolúmenes btrfs, ejecuta
            los servicios en contenedores gestionados por systemd y orquesta la red de
            forma automática — incluyendo la redirección de puertos por UPnP y las
            asignaciones de puertos de cada paquete. Es un sistema operativo completo para
            servidores domésticos, hecho para gente real.
          </p>
        </div>
        <div class="intro-highlights">
          <div class="highlight-card">
            <h3>Cero instalación</h3>
            <p>Arranca desde una memoria USB. Town OS se ejecuta en RAM y usa tus discos para datos, no para el sistema.</p>
          </div>
          <div class="highlight-card">
            <h3>Recuperación inmediata</h3>
            <p>¿Te has equivocado? Reinicia para volver a un estado que sabes que funciona. Actualiza cambiando la memoria USB.</p>
          </div>
          <div class="highlight-card">
            <h3>Plataforma de contenedores completa</h3>
            <p>Hecha para casas y oficinas pequeñas. Instala servicios desde repositorios de paquetes con una interfaz clara — unas preguntas guiadas configuran cada servicio, y la red y el almacenamiento se gestionan solos. Los paquetes también pueden ser máquinas virtuales o aplicaciones de Windows mediante Proton, no solo contenedores.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Install Command -->
  <section class="install-banner" id="install">
    <div class="container">
      <div class="install-box">
        <p class="install-label">Graba Town OS en una memoria USB:</p>
        <div class="install-command" id="install-command">
          <code>curl -sSLO https://town-os.github.io/install.sh && bash install.sh</code>
          <button class="copy-btn" id="copy-btn" aria-label="Copiar al portapapeles">Copiar</button>
        </div>
        <p class="install-note">
          Requiere <a href="https://podman.io/" target="_blank" rel="noopener">Podman</a> y
          formatea la memoria USB que elijas. Es un procedimiento avanzado — si no te sientes
          cómodo en la línea de comandos, <strong>pídele a un amigo con conocimientos técnicos
          en quien confíes que te lo instale</strong>, para que todos podáis comunicaros en
          vuestro propio Town.
        </p>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section features-section">
    <div class="container">
      <h2 class="section-title">Hecho para todos</h2>
      <div class="features-grid">
        <div class="card feature-card">
          <h3>Almacenamiento inteligente</h3>
          <p>Almacenamiento integrado y fiable, al que el sistema operativo no afecta en absoluto.</p>
          <ul class="feature-list">
            <li>Los paquetes se integran con el almacenamiento sin fricción — las cuotas se gestionan por paquete</li>
            <li>Archiva y descarga volúmenes como copias de seguridad comprimidas</li>
            <li>Sube ficheros comprimidos y gestiona tus propios volúmenes a mano si lo prefieres</li>
            <li>El RAID se configura automáticamente a partir de los discos existentes, agrupándolos para lograr la mejor redundancia durante la instalación</li>
            <li>Tus datos se mantienen ordenados y protegidos</li>
          </ul>
        </div>
        <div class="card feature-card">
          <h3>Red integrada</h3>
          <p>Gestiona toda tu red local desde un solo equipo.</p>
          <ul class="feature-list">
            <li>DNS integrado con <a href="https://gitea.com/town-os/rolodex" target="_blank" rel="noopener">rolodex</a> — gestiona las zonas autoritativas de tus paquetes y reenvía las consultas al exterior</li>
            <li>Redirección de puertos automática por UPnP para el acceso externo</li>
            <li>Asignaciones de puertos por paquete y red entre dependencias</li>
            <li>DNSSEC, bloqueo de anuncios, certificados ACME y DHCP muy pronto</li>
          </ul>
        </div>
        <div class="card feature-card">
          <h3>Ecosistema de paquetes</h3>
          <p>Instala servicios con un clic y configúralos con preguntas guiadas. <a href={L('packaging/')}>Crea tus propios repositorios</a> junto a los que vienen de serie.</p>
          <ul class="feature-list">
            <li>Monta uno para tu barrio o para un negocio con varias oficinas</li>
            <li>Controla tu cadena de cafeterías</li>
            <li>Sé dueño de toda tu infraestructura en tu ISP de barrio</li>
            <li>Mantén seguros a tus padres o a tus hijos con las herramientas que tú quieres que usen</li>
            <li>Monta una red de Mastodon o un Minecraft para los amigos de tus hijos</li>
            <li>Gitea, Jitsi, Plex, bases de datos, servidores web y más</li>
            <li>Publica sitios HTML estáticos directamente desde la interfaz</li>
            <li>Red y almacenamiento gestionados automáticamente por paquete</li>
          </ul>
        </div>
        <div class="card feature-card">
          <h3>Interfaz amigable</h3>
          <p>Un panel claro para todo el mundo.</p>
          <ul class="feature-list">
            <li>Gestiona servicios, almacenamiento, usuarios y paquetes</li>
            <li>Registro de auditoría integrado para cada acción</li>
            <li>Integración en vivo con el journal de systemd para los registros de los servicios</li>
            <li>Prometheus y Node Exporter con paneles integrados — con la opción de pasar a Grafana</li>
            <li>Disponible en 21 idiomas — las traducciones de la comunidad son bienvenidas</li>
            <li>Seguro e intuitivo para quien no es técnico, y con la potencia que necesitan los administradores</li>
          </ul>
        </div>
        <div class="card feature-card">
          <h3>Rápido, flexible y seguro</h3>
          <p>El sistema operativo se ejecuta por completo en RAM — tus discos son para tus datos.</p>
          <ul class="feature-list">
            <li>Sistema operativo inmutable en la memoria USB — resistente a manipulaciones por diseño</li>
            <li>Actualizaciones de los componentes por la red</li>
            <li>Actualizaciones sin sobresaltos — casi todo se arregla reiniciando</li>
            <li>Registro de auditoría y registros de servicios en vivo</li>
            <li>Gestión de cuotas por volumen</li>
            <li>Detección de actualizaciones de paquetes con aviso en el panel</li>
            <li><strong>API REST completa</strong> — ya existen clientes y se publicarán pronto</li>
          </ul>
        </div>
        <div class="card feature-card">
          <h3>Código abierto</h3>
          <p>Bajo licencia GNU AGPL 3.0.</p>
          <ul class="feature-list">
            <li>El código siempre está disponible para revisarse — por profesionales de seguridad, escáneres automáticos y vigilantes por igual</li>
            <li>Quien lo empaquete o lo modifique está obligado a publicarlo</li>
            <li>Nadie puede aprovecharse de los usuarios sin que alguien se entere</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Default Packages -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Repositorio de paquetes predeterminado</h2>
      <div class="repo-highlight">
        <div class="repo-info">
          <p>
            Cada instalación de Town OS incluye el repositorio
            <a href="https://github.com/town-os/default-packages" target="_blank" rel="noopener">default-packages</a>,
            un conjunto curado de servicios autoalojados:
          </p>
          <div class="tag-grid">
            <span class="tag">Gitea</span>
            <span class="tag">Jitsi Meet</span>
            <span class="tag">Mattermost</span>
            <span class="tag">Plex</span>
            <span class="tag">PostgreSQL</span>
          </div>
          <p>
            Los paquetes están probados en distinta medida — Gitea, Plex y PostgreSQL
            funcionan bien hoy. El repositorio predeterminado sigue creciendo, y las pull
            requests para añadir o mejorar paquetes son bienvenidas. También puedes crear
            tus propios repositorios privados — perfectos para la familia, los amigos o
            despliegues a medida.
          </p>
          <a href="https://github.com/town-os/default-packages" class="btn btn-primary" target="_blank" rel="noopener">
            Ver los paquetes en GitHub
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Documentation quick links -->
  <section class="section">
    <div class="container">
      <h2 class="section-title">Documentación</h2>
      <div class="docs-grid">
        <a href={L('concepts/')} class="card doc-link">
          <h3>Conceptos</h3>
          <p>Entiende las ideas centrales detrás de Town OS — paquetes, preguntas, servicios, red, almacenamiento y repositorios.</p>
        </a>
        <a href={L('packaging/')} class="card doc-link">
          <h3>Formato de empaquetado</h3>
          <p>Aprende cómo se definen los paquetes, cómo funciona el sistema de plantillas y cómo aportar los tuyos.</p>
        </a>
        <a href={L('api/')} class="card doc-link">
          <h3>Referencia de la API</h3>
          <p>La API completa para controlar Town OS — 77 endpoints entre cuentas, almacenamiento, repositorios, paquetes, systemd, ajustes, auditoría, páginas, DNS y más.</p>
        </a>
        <a href={L('screenshots/')} class="card doc-link">
          <h3>Capturas de pantalla</h3>
          <p>Mira Town OS en acción — el panel, la gestión de paquetes, el almacenamiento y la supervisión de servicios.</p>
        </a>
      </div>
    </div>
  </section>

  <script>
    const btn = document.getElementById('copy-btn');
    if (btn) {
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText('curl -sSLO https://town-os.github.io/install.sh && bash install.sh').then(() => {
          btn.textContent = '¡Copiado!';
          setTimeout(() => { btn.textContent = 'Copiar'; }, 2000);
        });
      });
    }
  </script>
</BaseLayout>

<style>
  /* Install Banner */
  .install-banner {
    background: var(--color-bg-elevated);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 3.5rem 0;
  }

  .install-box {
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }

  .install-label {
    color: var(--color-text);
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .install-command {
    display: inline-flex;
    align-items: stretch;
    gap: 0;
    max-width: 100%;
    background: var(--color-code-bg);
    border: 2px solid var(--color-primary);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(91, 76, 158, 0.3);
  }

  .install-command code {
    padding: 1.1rem 1.5rem;
    color: var(--color-accent);
    font-size: 1.2rem;
    background: none;
    border-radius: 0;
    user-select: all;
    overflow-x: auto;
    white-space: nowrap;
  }

  .copy-btn {
    padding: 1.1rem 1.75rem;
    background: var(--color-primary);
    color: var(--color-text);
    border: none;
    border-left: 1px solid var(--color-border);
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .copy-btn:hover {
    background: var(--color-primary-light);
  }

  .install-note {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.7;
    margin: 1.5rem auto 0;
    max-width: 640px;
  }

  .install-note strong {
    color: var(--color-text);
  }

  .install-note a {
    color: var(--color-accent);
    font-weight: 600;
  }

  /* First Release Banner */
  .release-banner {
    background: linear-gradient(135deg, #473c7a 0%, #2c2456 100%);
    border-bottom: 1px solid var(--color-primary-light);
    padding: 1.25rem 0;
  }

  .release-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    text-align: center;
  }

  .release-badge {
    display: inline-block;
    background: #1c1740;
    color: #a49dc4;
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    padding: 0.4rem 1.1rem;
    border-radius: 6px;
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }

  .release-text {
    color: #a49dc4;
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.5;
    max-width: 720px;
  }

  .release-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .banner-btn {
    padding: 0.6rem 1.4rem;
  }

  .hero-actions .try-teal {
    background: #5e857e;
    color: var(--color-bg);
  }

  .hero-actions .try-teal:hover {
    background: #6b948c;
    color: var(--color-bg);
  }

  .banner-btn-primary {
    background: #5e857e;
    color: var(--color-bg);
  }

  .banner-btn-primary:hover {
    background: #6b948c;
    color: var(--color-bg);
  }

  .banner-btn-outline {
    background: rgba(0, 0, 0, 0.2);
    color: #a49dc4;
    border: 2px solid rgba(255, 255, 255, 0.5);
  }

  .banner-btn-outline:hover {
    background: rgba(0, 0, 0, 0.35);
    border-color: #fff;
  }

  /* Preview Screenshots */
  .preview-section {
    background: var(--color-bg);
    padding: 2.5rem 0;
  }

  .preview-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .preview-item {
    display: block;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }

  .preview-item:hover {
    border-color: var(--color-primary-dim);
    transform: translateY(-2px);
  }

  .preview-item img {
    width: 100%;
    height: auto;
    display: block;
  }

  .preview-label {
    display: block;
    padding: 0.5rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-align: center;
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 6rem 0 5rem;
    text-align: center;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
  }


  .hero-content {
    position: relative;
    z-index: 1;
  }

  .hero-logo {
    margin-bottom: 1.5rem;
    filter: drop-shadow(0 4px 20px rgba(91, 76, 158, 0.4));
  }

  .hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-text-box {
    background: rgba(0, 0, 0, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 12px;
    padding: 1.75rem 2.25rem;
    max-width: 640px;
    margin: 0 auto 2rem;
  }

  .hero-lead {
    font-size: 1.25rem;
    color: #c0c0d0;
    font-weight: 700;
    margin: 0 0 1rem;
    line-height: 1.7;
  }

  .hero-bullets {
    list-style: none;
    margin: 0;
    padding-left: 1.5rem;
    text-align: left;
  }

  .hero-bullets li {
    color: #a8a8b8;
    font-size: 1.1rem;
    line-height: 1.8;
    padding-left: 1.5rem;
    position: relative;
  }

  .hero-bullets li::before {
    content: "\2022";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Intro */
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .intro-text p {
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    font-size: 1.05rem;
  }

  .intro-text strong {
    color: var(--color-text);
  }

  .intro-highlights {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .highlight-card {
    background: var(--color-bg-card);
    border-left: 3px solid var(--color-primary);
    padding: 1.25rem 1.5rem;
    border-radius: 0 8px 8px 0;
  }

  .highlight-card h3 {
    margin-bottom: 0.4rem;
    font-size: 1.1rem;
  }

  .highlight-card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  /* Features */
  .features-section {
    background: var(--color-bg-elevated);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .feature-card h3 {
    margin-bottom: 0.6rem;
    color: var(--color-accent);
  }

  .feature-card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .feature-list li {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.7;
    padding-left: 1.1rem;
    position: relative;
  }

  .feature-list li::before {
    content: "\2022";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .feature-list a {
    color: var(--color-accent);
  }

  .feature-sublist {
    list-style: none;
    padding: 0;
    margin: 0.2rem 0 0 0.75rem;
  }

  .feature-sublist li {
    font-size: 0.85rem;
    padding-left: 1rem;
  }

  .feature-sublist li::before {
    content: "\2013";
  }

  /* Repo highlight */
  .repo-highlight {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 2.5rem;
  }

  .repo-info p {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin-bottom: 1.25rem;
  }

  .repo-info strong {
    color: var(--color-text);
  }

  .tag-grid {
    display: flex;
